{
  "name": "posissue-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w posissue -w @posissue/core -w @posissue/server",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "npm run build",
    "test": "vitest run",
    "publish:all": "npm publish -w posissue -w @posissue/core -w @posissue/server"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "bin": {
    "posissue": "cli/posissue.mjs"
  }
}
