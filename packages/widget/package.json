{
  "name": "posissue",
  "version": "1.5.0",
  "description": "A feedback widget that lets anyone send GitHub issues — no GitHub account needed.",
  "keywords": [
    "github",
    "issues",
    "feedback",
    "widget",
    "bug-report",
    "open-source",
    "cloudflare-workers"
  ],
  "homepage": "https://posissue.2nj.lol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninjin0802/posissue.git",
    "directory": "packages/widget"
  },
  "bugs": "https://github.com/ninjin0802/posissue/issues",
  "author": "ninjin0802",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "posissue": "cli/posissue.mjs"
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist cli && tsc -p tsconfig.build.json && mkdir -p cli && cp ../../cli/posissue.mjs cli/ && cp ../../LICENSE .",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
